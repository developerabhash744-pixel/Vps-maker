# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
ADMIN_IDS=123456789012345678,987654321098765432

# Discord Proxy URL (Optional: Cloudflare Worker proxy if bot host has outbound firewall)
DISCORD_PROXY_URL=https://silent-wind-4838.pabhash015.workers.dev

# Server Public IP (Optional: specify manual public IP or hostname for SSH)
# SERVER_IP="123.45.67.89"

# Ngrok Auth Token (Recommended: Free TCP/HTTP tunnels from https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Brand & Customization
HOSTING_NAME="NovaCloud"
BRAND_COLOR="#5865F2"
DEFAULT_IMAGE="ubuntu:24.04"
MAX_VPS_PER_USER=1
PIDS_LIMIT=250
